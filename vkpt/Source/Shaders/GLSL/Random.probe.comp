#version 460

#extension GL_EXT_samplerless_texture_functions : require

// Random.h has no shader stage of its own, so this pair exists to check Random.hlsli. Every helper
// of the header is called and the blue noise texture is declared, so that CheckShaderProperties.py
// sees the descriptor set and binding of that texture, its resource kind, and the builtins and
// bytes that the two bodies agree on.
//
// Random.h includes nothing itself, so the probe pulls in exactly what its consumers do: Utils.h
// for M_PI and safePositiveRcp, the generated header for BLUE_NOISE_TEXTURE_SIZE*.
//
// The output buffer sits in set 8, which no shader of the build uses, so that the probe never
// shadows a real descriptor set.

#define DESC_SET_RANDOM 5

#include "Utils.h"
#include "ShaderCommonGLSL.h"
#include "Random.h"

layout(binding = 0, set = 8, std430) writeonly buffer ProbeOutput { float o[]; };

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    float v = 0.0;

    const uint seed = packRandomSeed(3, uvec2(1, 2));

    uint texIndex;
    uvec2 offset;
    unpackRandomSeed(seed, texIndex, offset);
    v += float(texIndex) + float(offset.x) + float(offset.y);

    v += rndBlueNoise8(seed, 7).x;

    v += rnd16(seed, 1) + rnd16_2(seed, 2).y + rnd8_4(seed, 3).w;
    v += float(wellonsLowBias32(seed));
    v += float(murmurHash33(uvec3(1, 2, 3)).z) + float(getRandomSeed(ivec2(1, 2), 4));

    v += sampleDisk(1.0, 0.25, 0.75).x;
    v += sampleTriangle(vec3(0), vec3(1, 0, 0), vec3(0, 1, 0), 0.5, 0.25).y;

    float oneOverPdf = 0.0;
    v += sampleHemisphere(0.25, 0.75, oneOverPdf).z;
    v += oneOverPdf;
    v += sampleSphere(0.25, 0.75).x;

    const vec3 n = normalize(vec3(0.3, 0.4, 0.5));
    vec3 b1;
    vec3 b2;

    revisedONB(n, b1, b2);
    v += b1.x + b2.y;
    frisvadONB(n, b1, b2);
    v += b1.z + b2.z;

    const mat3 basis = getONB(n);
    v += basis[0].y + basis[2].z;

    v += sampleOrientedHemisphere(n, 0.25, 0.75, oneOverPdf).y;
    v += oneOverPdf;

    o[0] = v;
}
